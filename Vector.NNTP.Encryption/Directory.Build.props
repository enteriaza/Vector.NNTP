<Project>
  <PropertyGroup>
    <!-- x64-only build surface: see .cursor/rules/x64-platform-only.mdc -->
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1574;CS0419;CS1580;CS1734</NoWarn>

    <MajorVersion>1</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <BuildNumber>$([System.DateTime]::UtcNow.DayOfYear)</BuildNumber>
    <RevisionNumber>$([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalSeconds), 2))))</RevisionNumber>

    <AssemblyVersion>$(MajorVersion).$(MinorVersion).$(BuildNumber).$(RevisionNumber)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
