<Project>
  <PropertyGroup>
    <!-- x64-only build surface: see .cursor/rules/x64-platform-only.mdc -->
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 enforced: every public/internal member must have XML docs. Cref issues remain suppressed like Utilities. -->
    <NoWarn>$(NoWarn);CS1574;CS0419;CS1580;CS1734</NoWarn>
  </PropertyGroup>
</Project>

