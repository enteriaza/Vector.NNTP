<Project Sdk="Microsoft.NET.Sdk">

  <!--
  ════════════════════════════════════════════════════════════════════
  Vector.NNTP.Tests — solution-wide unit and integration tests
  ════════════════════════════════════════════════════════════════════
  Single test assembly for MessageBus, NNTPD, NNRPD, and future projects.
  Organize tests under subfolders mirroring product areas (e.g. MessageBus/).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vector.NNTP.Tests</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="RocksDB" Version="10.4.2.64152" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vector.NNTP.Encryption\Vector.NNTP.Encryption.csproj" />
    <ProjectReference Include="..\Vector.NNTP.Filters\Vector.NNTP.Filters.csproj" />
    <ProjectReference Include="..\Vector.NNTP.Sockets\Vector.NNTP.Sockets.csproj" />
    <ProjectReference Include="..\Vector.NNTP.MessageBus\Vector.NNTP.MessageBus.csproj" />
    <ProjectReference Include="..\Vector.NNTP.NNRPD\Vector.NNTP.NNRPD.csproj" />
    <ProjectReference Include="..\Vector.NNTP.NNTPD\Vector.NNTP.NNTPD.csproj" />
    <ProjectReference Include="..\Vector.NNTP.Auth.MySql\Vector.NNTP.Auth.MySql.csproj" />
    <ProjectReference Include="..\Vector.NNTP.Session\Vector.NNTP.Session.csproj" />
    <ProjectReference Include="..\Vector.NNTP.HistoryDB\Vector.NNTP.HistoryDB.csproj" />
    <ProjectReference Include="..\Vector.NNTP.Session.Redis\Vector.NNTP.Session.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\YEnc\sabctools\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
